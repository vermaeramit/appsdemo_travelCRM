@model PaymentFormVm
@{
    ViewData["Title"] = "Record Payment";
    var pathBase = Context.Request.PathBase.Value ?? "";
}

<div class="page-header">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="text-secondary"><a href="@pathBase/payments" class="text-reset"><i class="ti ti-arrow-left me-1"></i>Back to payments</a></div>
            <h2 class="page-title mt-1">Record Payment</h2>
        </div>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mb-3">
        <ul class="mb-0">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            { <li>@err.ErrorMessage</li> }
        </ul>
    </div>
}

<div class="row">
    <div class="col-md-6">
        <form method="post" action="@pathBase/payments/new">
            @Html.AntiForgeryToken()
            <div class="card">
                <div class="card-header"><h3 class="card-title">Payment Details</h3></div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label required">Payment Date</label>
                            <input type="date" name="PaymentDate" value="@Model.PaymentDate.ToString("yyyy-MM-dd")"
                                   class="form-control" required/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label required">Mode</label>
                            <select name="Mode" class="form-select" required>
                                @foreach (var m in PaymentMode.All)
                                {
                                    <option value="@m" selected="@(Model.Mode == m)">@m</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label required">Amount</label>
                            <input type="number" name="Amount" value="@Model.Amount" class="form-control"
                                   required step="0.01" min="0.01" placeholder="0.00"/>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label required">Currency</label>
                            <input name="CurrencyCode" value="@Model.CurrencyCode" class="form-control" maxlength="3"/>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Reference / Cheque No.</label>
                            <input name="ReferenceNo" value="@Model.ReferenceNo" class="form-control" maxlength="100"
                                   placeholder="Transaction ID, cheque number, etc."/>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notes</label>
                            <textarea name="Notes" class="form-control" rows="3" maxlength="500">@Model.Notes</textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex mt-3">
                <a href="@pathBase/payments" class="btn me-auto">Cancel</a>
                <button type="submit" class="btn btn-primary">
                    <i class="ti ti-cash me-1"></i>Record Payment
                </button>
            </div>
        </form>
    </div>
</div>
