@model ResetPasswordVm
@{
    ViewData["Title"] = "Reset Password";
    var pathBase = Context.Request.PathBase.Value ?? "";
}

<div class="page-header">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="text-secondary"><a href="@pathBase/users/@Model.UserId" class="text-reset"><i class="ti ti-arrow-left me-1"></i>Back to user</a></div>
            <h2 class="page-title mt-1">Reset Password — @Model.UserName</h2>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-5">
        <div class="card">
            <div class="card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger mb-3">
                        @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        { <div>@err.ErrorMessage</div> }
                    </div>
                }
                <form method="post" action="@pathBase/users/@Model.UserId/reset-password">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="UserId" value="@Model.UserId"/>
                    <input type="hidden" name="UserName" value="@Model.UserName"/>
                    <div class="mb-3">
                        <label class="form-label required">New Password</label>
                        <input type="password" name="NewPassword" class="form-control" required minlength="8"
                               autocomplete="new-password" placeholder="Minimum 8 characters"/>
                    </div>
                    <div class="alert alert-info mb-3 py-2">
                        <i class="ti ti-info-circle me-1"></i>
                        The user will be required to change this password on their next login.
                    </div>
                    <div class="d-flex">
                        <a href="@pathBase/users/@Model.UserId" class="btn me-auto">Cancel</a>
                        <button type="submit" class="btn btn-warning">
                            <i class="ti ti-key me-1"></i>Reset Password
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
