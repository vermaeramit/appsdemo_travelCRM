@model InvoiceFormVm
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? $"Edit {Model.InvoiceNo}" : "New Invoice";
    var pathBase = Context.Request.PathBase.Value ?? "";
    var formAction = isEdit ? $"{pathBase}/invoices/{Model.Id}/edit" : $"{pathBase}/invoices/new";
    var itemsJson = System.Text.Json.JsonSerializer.Serialize(Model.Items.Select(i => new {
        description = i.Description,
        hsnSac = i.HsnSac ?? "",
        qty = i.Qty,
        unitPrice = i.UnitPrice,
        taxRate = i.TaxRate
    }));
}

<div class="page-header">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="text-secondary"><a href="@pathBase/invoices" class="text-reset"><i class="ti ti-arrow-left me-1"></i>Back to invoices</a></div>
            <h2 class="page-title mt-1">@(isEdit ? $"Edit {Model.InvoiceNo}" : "New Invoice")</h2>
        </div>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mb-3">
        <ul class="mb-0">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            { <li>@err.ErrorMessage</li> }
        </ul>
    </div>
}

<form method="post" action="@formAction" x-data="invoiceBuilder(@Html.Raw(itemsJson))">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="Id" value="@Model.Id"/> }
    @if (Model.BookingId.HasValue)
    {
        <input type="hidden" name="BookingId" value="@Model.BookingId"/>
        <div class="alert alert-info mb-3 py-2">
            <i class="ti ti-info-circle me-1"></i>
            Creating invoice from booking <strong>@Model.BookingNo</strong>. Items pre-filled.
        </div>
    }

    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header"><h3 class="card-title">Customer &amp; Invoice</h3></div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label required">Customer Name</label>
                            <input name="CustomerName" value="@Model.CustomerName" class="form-control" required maxlength="200"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Customer GSTIN</label>
                            <input name="CustomerGstin" value="@Model.CustomerGstin" class="form-control" maxlength="20"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Booking</label>
                            <select name="BookingId" class="form-select" @(Model.BookingId.HasValue ? "disabled" : "")>
                                <option value="">— none —</option>
                                @foreach (var b in Model.Bookings)
                                {
                                    <option value="@b.Value" selected="@(Model.BookingId?.ToString() == b.Value)">@b.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label required">Invoice Date</label>
                            <input type="date" name="InvoiceDate" value="@Model.InvoiceDate.ToString("yyyy-MM-dd")"
                                   class="form-control" required/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Due Date</label>
                            <input type="date" name="DueDate" value="@Model.DueDate?.ToString("yyyy-MM-dd")"
                                   class="form-control"/>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label required">Currency</label>
                            <input name="CurrencyCode" value="@Model.CurrencyCode" class="form-control" maxlength="3"/>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Status</label>
                            <select name="Status" class="form-select">
                                @foreach (var s in InvoiceStatus.All)
                                {
                                    <option value="@s" selected="@(Model.Status == s)">@s</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Branch</label>
                            <select name="BranchId" class="form-select">
                                <option value="">— none —</option>
                                @foreach (var b in Model.Branches)
                                {
                                    <option value="@b.Value" selected="@(Model.BranchId?.ToString() == b.Value)">@b.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notes</label>
                            <textarea name="Notes" class="form-control" rows="3">@Model.Notes</textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header"><h3 class="card-title">Live Summary</h3></div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Sub Total</span>
                        <span x-text="subTotal.toFixed(2)">0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Tax</span>
                        <span x-text="taxTotal.toFixed(2)">0.00</span>
                    </div>
                    <hr/>
                    <div class="d-flex justify-content-between fw-bold fs-4">
                        <span>Grand Total</span>
                        <span x-text="grandTotal.toFixed(2)">0.00</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header d-flex align-items-center">
            <h3 class="card-title mb-0">Line Items</h3>
            <button type="button" class="btn btn-sm btn-outline-primary ms-auto" @@click="addItem()">
                <i class="ti ti-plus me-1"></i>Add Item
            </button>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>Description</th>
                        <th style="width:100px">HSN/SAC</th>
                        <th style="width:70px" class="text-end">Qty</th>
                        <th style="width:100px" class="text-end">Unit Price</th>
                        <th style="width:80px" class="text-end">Tax %</th>
                        <th style="width:100px" class="text-end">Total</th>
                        <th style="width:40px"></th>
                    </tr>
                </thead>
                <tbody>
                    <template x-for="(item, idx) in items" :key="idx">
                        <tr>
                            <td>
                                <input type="text" :name="'Items[' + idx + '].Description'" x-model="item.description"
                                       class="form-control form-control-sm" placeholder="Service description" required/>
                            </td>
                            <td>
                                <input type="text" :name="'Items[' + idx + '].HsnSac'" x-model="item.hsnSac"
                                       class="form-control form-control-sm" maxlength="20"/>
                            </td>
                            <td>
                                <input type="number" :name="'Items[' + idx + '].Qty'" x-model.number="item.qty"
                                       class="form-control form-control-sm text-end" step="0.01" min="0"/>
                            </td>
                            <td>
                                <input type="number" :name="'Items[' + idx + '].UnitPrice'" x-model.number="item.unitPrice"
                                       class="form-control form-control-sm text-end" step="0.01" min="0"/>
                            </td>
                            <td>
                                <input type="number" :name="'Items[' + idx + '].TaxRate'" x-model.number="item.taxRate"
                                       class="form-control form-control-sm text-end" step="0.01" min="0" max="100"/>
                            </td>
                            <td class="text-end fw-semibold"
                                x-text="(item.qty * item.unitPrice * (1 + item.taxRate / 100)).toFixed(2)">0.00</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-ghost-danger" @@click="removeItem(idx)">
                                    <i class="ti ti-trash"></i>
                                </button>
                            </td>
                        </tr>
                    </template>
                    <tr x-show="items.length === 0">
                        <td colspan="7" class="text-center text-secondary py-3">No items. Click "Add Item".</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex">
        <a href="@pathBase/invoices" class="btn me-auto">Cancel</a>
        <button type="submit" class="btn btn-primary">
            <i class="ti ti-device-floppy me-1"></i>@(isEdit ? "Save Changes" : "Create Invoice")
        </button>
    </div>
</form>

<script>
function invoiceBuilder(initialItems) {
    return {
        items: initialItems.length ? initialItems : [],
        addItem() { this.items.push({ description: '', hsnSac: '', qty: 1, unitPrice: 0, taxRate: 0 }); },
        removeItem(idx) { this.items.splice(idx, 1); },
        get subTotal()  { return this.items.reduce((s, i) => s + i.qty * i.unitPrice, 0); },
        get taxTotal()  { return this.items.reduce((s, i) => s + i.qty * i.unitPrice * i.taxRate / 100, 0); },
        get grandTotal() { return this.subTotal + this.taxTotal; }
    };
}
</script>
