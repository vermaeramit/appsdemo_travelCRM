@model QuoteFormVm
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? $"Edit Quote {Model.QuoteNo}" : "New Quote";
    var pathBase = Context.Request.PathBase.Value ?? "";
    var formAction = isEdit ? $"{pathBase}/quotes/{Model.Id}/edit" : $"{pathBase}/quotes/new";

    var itemsJson = System.Text.Json.JsonSerializer.Serialize(Model.Items.Select(i => new
    {
        dayNo       = i.DayNo?.ToString() ?? "",
        itemDate    = i.ItemDate?.ToString("yyyy-MM-dd") ?? "",
        itemType    = i.ItemType,
        description = i.Description ?? "",
        qty         = i.Qty,
        unitCost    = i.UnitCost,
        unitSale    = i.UnitSale,
        taxRate     = i.TaxRate
    }));

    var termsJson = System.Text.Json.JsonSerializer.Serialize(Model.Terms);
}

<div class="page-header">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="text-secondary"><a href="@pathBase/quotes" class="text-reset"><i class="ti ti-arrow-left me-1"></i>Back to quotes</a></div>
            <h2 class="page-title mt-1">
                <i class="ti ti-file-invoice me-2"></i>
                @(isEdit ? $"Edit Quote {Model.QuoteNo}" : "New Quote")
            </h2>
        </div>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mb-3">
        <ul class="mb-0">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            { <li>@err.ErrorMessage</li> }
        </ul>
    </div>
}

<form method="post" action="@formAction" x-data="quoteBuilder()" x-init="init()">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="Id" value="@Model.Id"/> }

    @* Header row *@
    <div class="row g-3 mb-3">
        @* Customer / Lead *@
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header"><h3 class="card-title">Customer</h3></div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Link to Lead</label>
                        <select name="LeadId" class="form-select" id="leadSelect">
                            <option value="">— standalone quote —</option>
                            @foreach (var l in Model.Leads)
                            {
                                <option value="@l.Value" selected="@(Model.LeadId?.ToString() == l.Value)">@l.Text</option>
                            }
                        </select>
                        <div class="form-text">Leave blank for a standalone quote.</div>
                    </div>
                    <div class="mb-0" id="standaloneNameRow">
                        <label class="form-label">Customer Name <span class="text-secondary">(standalone)</span></label>
                        <input name="CustomerNameDisplay" value="@Model.CustomerNameDisplay"
                               class="form-control" maxlength="200"
                               placeholder="Required if no lead selected"/>
                    </div>
                </div>
            </div>
        </div>

        @* Quote settings *@
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header"><h3 class="card-title">Quote Settings</h3></div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Status</label>
                        <select name="Status" class="form-select">
                            @foreach (var s in QuoteStatus.All)
                            {
                                <option value="@s" selected="@(Model.Status == s)">@s</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Valid Till</label>
                        <input type="date" name="ValidTill"
                               value="@(Model.ValidTill?.ToString("yyyy-MM-dd"))"
                               class="form-control"/>
                    </div>
                    <div class="row">
                        <div class="col-5 mb-0">
                            <label class="form-label required">Currency</label>
                            <input name="CurrencyCode" value="@Model.CurrencyCode"
                                   class="form-control text-uppercase" maxlength="3" required/>
                        </div>
                        <div class="col-7 mb-0">
                            <label class="form-label">Branch</label>
                            <select name="BranchId" class="form-select">
                                <option value="">— none —</option>
                                @foreach (var b in Model.Branches)
                                {
                                    <option value="@b.Value" selected="@(Model.BranchId?.ToString() == b.Value)">@b.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Totals summary *@
        <div class="col-lg-4">
            <div class="card h-100 border-primary">
                <div class="card-header bg-primary-lt"><h3 class="card-title text-primary">Quote Summary</h3></div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Total Cost</span>
                        <span x-text="fmt(totalCost)" class="text-muted">0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Total Sale</span>
                        <span x-text="fmt(totalSale)">0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Tax</span>
                        <span x-text="fmt(totalTax)">0.00</span>
                    </div>
                    <hr class="my-2"/>
                    <div class="d-flex justify-content-between">
                        <strong>Grand Total</strong>
                        <strong class="text-primary fs-4" x-text="fmt(grandTotal)">0.00</strong>
                    </div>
                    <div class="mt-3">
                        <div class="d-flex justify-content-between small text-secondary mb-1">
                            <span>Margin</span>
                            <span x-text="margin + '%'">0%</span>
                        </div>
                        <div class="progress progress-sm">
                            <div class="progress-bar bg-success" :style="'width:' + Math.min(margin,100) + '%'"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Line Items *@
    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title">Itinerary Items</h3>
            <div class="card-options">
                <button type="button" class="btn btn-sm btn-outline-primary" @@click="addItem()">
                    <i class="ti ti-plus me-1"></i>Add Row
                </button>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table card-table table-vcenter">
                <thead>
                    <tr>
                        <th style="width:60px">Day</th>
                        <th style="width:130px">Date</th>
                        <th style="width:130px">Type</th>
                        <th>Description</th>
                        <th style="width:80px">Qty</th>
                        <th style="width:110px">Unit Cost</th>
                        <th style="width:110px">Unit Sale</th>
                        <th style="width:75px">Tax %</th>
                        <th style="width:110px" class="text-end">Line Total</th>
                        <th style="width:40px"></th>
                    </tr>
                </thead>
                <tbody>
                    <template x-for="(item, idx) in items" :key="idx">
                        <tr>
                            <td>
                                <input type="number" min="1" :name="'Items[' + idx + '].DayNo'"
                                       x-model="item.dayNo" class="form-control form-control-sm"/>
                            </td>
                            <td>
                                <input type="date" :name="'Items[' + idx + '].ItemDate'"
                                       x-model="item.itemDate" class="form-control form-control-sm"/>
                            </td>
                            <td>
                                <select :name="'Items[' + idx + '].ItemType'"
                                        x-model="item.itemType" class="form-select form-select-sm">
                                    <template x-for="t in itemTypes" :key="t">
                                        <option :value="t" x-text="t"></option>
                                    </template>
                                </select>
                            </td>
                            <td>
                                <input type="text" :name="'Items[' + idx + '].Description'"
                                       x-model="item.description" class="form-control form-control-sm"
                                       placeholder="Descriptionâ€¦"/>
                            </td>
                            <td>
                                <input type="number" step="0.01" min="0" :name="'Items[' + idx + '].Qty'"
                                       x-model.number="item.qty" class="form-control form-control-sm"/>
                            </td>
                            <td>
                                <input type="number" step="0.01" min="0" :name="'Items[' + idx + '].UnitCost'"
                                       x-model.number="item.unitCost" class="form-control form-control-sm"/>
                            </td>
                            <td>
                                <input type="number" step="0.01" min="0" :name="'Items[' + idx + '].UnitSale'"
                                       x-model.number="item.unitSale" class="form-control form-control-sm"/>
                            </td>
                            <td>
                                <input type="number" step="0.01" min="0" max="100" :name="'Items[' + idx + '].TaxRate'"
                                       x-model.number="item.taxRate" class="form-control form-control-sm"/>
                            </td>
                            <td class="text-end fw-medium" x-text="fmt(lineTotal(item))"></td>
                            <td>
                                <input type="hidden" :name="'Items[' + idx + '].SortOrder'" :value="idx"/>
                                <button type="button" class="btn btn-sm btn-ghost-danger" @@click="removeItem(idx)">
                                    <i class="ti ti-trash"></i>
                                </button>
                            </td>
                        </tr>
                    </template>
                    <tr x-show="items.length === 0">
                        <td colspan="10" class="text-center text-secondary py-4">
                            No items yet. Click <strong>Add Row</strong> to start building the itinerary.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    @* Notes + Terms *@
    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header"><h3 class="card-title">Internal Notes</h3></div>
                <div class="card-body">
                    <textarea name="Notes" rows="4" class="form-control" maxlength="2000"
                              placeholder="Notes visible to your team onlyâ€¦">@Model.Notes</textarea>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Terms &amp; Conditions</h3>
                    <div class="card-options">
                        <button type="button" class="btn btn-sm btn-ghost-primary" @@click="addTerm()">
                            <i class="ti ti-plus"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <template x-for="(term, idx) in terms" :key="idx">
                        <div class="input-group mb-2">
                            <input type="text" :name="'Terms[' + idx + ']'"
                                   x-model="terms[idx]" class="form-control"
                                   placeholder="e.g. Rates are per person on twin sharing basis"/>
                            <button type="button" class="btn btn-outline-danger" @@click="removeTerm(idx)">
                                <i class="ti ti-x"></i>
                            </button>
                        </div>
                    </template>
                    <div x-show="terms.length === 0" class="text-secondary small">
                        No terms added. Click + to add a term.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex">
        <a href="@pathBase/quotes" class="btn me-auto">Cancel</a>
        <button type="submit" class="btn btn-primary">
            <i class="ti ti-device-floppy me-1"></i>@(isEdit ? "Save Changes" : "Create Quote")
        </button>
    </div>
</form>

<script>
function quoteBuilder() {
    return {
        items: [],
        terms: [],
        itemTypes: ['Hotel', 'Flight', 'Transport', 'Sightseeing', 'Meal', 'Misc'],

        init() {
            this.items = @Html.Raw(itemsJson);
            this.terms = @Html.Raw(termsJson);
        },

        get totalCost() {
            return this.items.reduce((s, i) => s + (parseFloat(i.qty)||0) * (parseFloat(i.unitCost)||0), 0);
        },
        get totalSale() {
            return this.items.reduce((s, i) => s + (parseFloat(i.qty)||0) * (parseFloat(i.unitSale)||0), 0);
        },
        get totalTax() {
            return this.items.reduce((s, i) =>
                s + (parseFloat(i.qty)||0) * (parseFloat(i.unitSale)||0) * (parseFloat(i.taxRate)||0) / 100, 0);
        },
        get grandTotal() { return this.totalSale + this.totalTax; },
        get margin() {
            if (this.totalCost <= 0) return 0;
            return Math.round((this.totalSale - this.totalCost) / this.totalCost * 100);
        },

        lineTotal(item) {
            const s = (parseFloat(item.qty)||0) * (parseFloat(item.unitSale)||0);
            return s * (1 + (parseFloat(item.taxRate)||0) / 100);
        },

        fmt(v) {
            return (parseFloat(v)||0).toLocaleString('en-IN', {minimumFractionDigits:2, maximumFractionDigits:2});
        },

        addItem() {
            this.items.push({ dayNo:'', itemDate:'', itemType:'Misc', description:'', qty:1, unitCost:0, unitSale:0, taxRate:0 });
        },
        removeItem(idx) { this.items.splice(idx, 1); },
        addTerm()   { this.terms.push(''); },
        removeTerm(idx) { this.terms.splice(idx, 1); }
    };
}
</script>

