@model BranchFormVm
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? "Edit Branch" : "New Branch";
    var pathBase = Context.Request.PathBase.Value ?? "";
    var formAction = isEdit ? $"{pathBase}/branches/{Model.Id}/edit" : $"{pathBase}/branches/new";
}

<div class="page-header">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="text-secondary"><a href="@pathBase/branches" class="text-reset"><i class="ti ti-arrow-left me-1"></i>Back to branches</a></div>
            <h2 class="page-title mt-1">@(isEdit ? "Edit Branch" : "New Branch")</h2>
        </div>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mb-3">
        <ul class="mb-0">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            { <li>@err.ErrorMessage</li> }
        </ul>
    </div>
}

<form method="post" action="@formAction">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="Id" value="@Model.Id"/> }

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header"><h3 class="card-title">Branch Details</h3></div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label required">Branch Name</label>
                            <input name="Name" value="@Model.Name" class="form-control" required maxlength="200"/>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label required">Code</label>
                            <input name="Code" value="@Model.Code" class="form-control" required maxlength="30"
                                   placeholder="e.g. DEL, MUM"/>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label">Address</label>
                            <input name="Address" value="@Model.Address" class="form-control" maxlength="300"/>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">City</label>
                            <input name="City" value="@Model.City" class="form-control" maxlength="100"/>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">State</label>
                            <input name="State" value="@Model.State" class="form-control" maxlength="100"/>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Country</label>
                            <input name="Country" value="@Model.Country" class="form-control" maxlength="100"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone</label>
                            <input name="Phone" value="@Model.Phone" class="form-control" maxlength="30"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Email</label>
                            <input type="email" name="Email" value="@Model.Email" class="form-control" maxlength="150"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">GSTIN</label>
                            <input name="Gstin" value="@Model.Gstin" class="form-control" maxlength="20"
                                   placeholder="GST number if applicable"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card">
                <div class="card-header"><h3 class="card-title">Settings</h3></div>
                <div class="card-body">
                    <label class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true"
                               @(Model.IsActive ? "checked" : "")/>
                        <span class="form-check-label">Active</span>
                    </label>
                    <label class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="IsHeadOffice" value="true"
                               @(Model.IsHeadOffice ? "checked" : "")/>
                        <span class="form-check-label">Head Office</span>
                    </label>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex mt-3">
        <a href="@pathBase/branches" class="btn me-auto">Cancel</a>
        <button type="submit" class="btn btn-primary">
            <i class="ti ti-device-floppy me-1"></i>@(isEdit ? "Save Changes" : "Create Branch")
        </button>
    </div>
</form>
