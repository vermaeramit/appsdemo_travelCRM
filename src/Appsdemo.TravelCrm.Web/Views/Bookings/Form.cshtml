@model BookingFormVm
@{
    var isEdit = Model.Id.HasValue;
    ViewData["Title"] = isEdit ? $"Edit {Model.BookingNo}" : "New Booking";
    var pathBase = Context.Request.PathBase.Value ?? "";
    var formAction = isEdit ? $"{pathBase}/bookings/{Model.Id}/edit" : $"{pathBase}/bookings/new";
    var itemsJson = System.Text.Json.JsonSerializer.Serialize(Model.Items.Select(i => new {
        dayNo = i.DayNo?.ToString() ?? "",
        itemDate = i.ItemDate?.ToString("yyyy-MM-dd") ?? "",
        itemType = i.ItemType,
        description = i.Description ?? "",
        qty = i.Qty,
        unitCost = i.UnitCost,
        unitSale = i.UnitSale,
        taxRate = i.TaxRate
    }));
}

<div class="page-header">
    <div class="row g-2 align-items-center">
        <div class="col">
            <div class="text-secondary"><a href="@pathBase/bookings" class="text-reset"><i class="ti ti-arrow-left me-1"></i>Back to bookings</a></div>
            <h2 class="page-title mt-1">@(isEdit ? $"Edit {Model.BookingNo}" : "New Booking")</h2>
        </div>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mb-3">
        <ul class="mb-0">
            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            { <li>@err.ErrorMessage</li> }
        </ul>
    </div>
}

<form method="post" action="@formAction" x-data="bookingBuilder(@Html.Raw(itemsJson))">
    @Html.AntiForgeryToken()
    @if (isEdit) { <input type="hidden" name="Id" value="@Model.Id"/> }
    @if (Model.QuoteId.HasValue)
    {
        <input type="hidden" name="QuoteId" value="@Model.QuoteId"/>
        <div class="alert alert-info mb-3 py-2">
            <i class="ti ti-info-circle me-1"></i>
            Creating booking from quote <strong>@Model.QuoteNo</strong>. Items pre-filled from quote.
        </div>
    }

    <div class="row g-3 mb-3">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header"><h3 class="card-title">Customer &amp; Trip</h3></div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label required">Customer Name</label>
                            <input name="CustomerName" value="@Model.CustomerName" class="form-control" required maxlength="200"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Travel Start</label>
                            <input type="date" name="TravelStart" value="@Model.TravelStart?.ToString("yyyy-MM-dd")"
                                   class="form-control"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Travel End</label>
                            <input type="date" name="TravelEnd" value="@Model.TravelEnd?.ToString("yyyy-MM-dd")"
                                   class="form-control"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Branch</label>
                            <select name="BranchId" class="form-select">
                                <option value="">— no branch —</option>
                                @foreach (var b in Model.Branches)
                                {
                                    <option value="@b.Value" selected="@(Model.BranchId?.ToString() == b.Value)">@b.Text</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label required">Currency</label>
                            <input name="CurrencyCode" value="@Model.CurrencyCode" class="form-control" maxlength="3"/>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Status</label>
                            <select name="Status" class="form-select">
                                @foreach (var s in BookingStatus.All)
                                {
                                    <option value="@s" selected="@(Model.Status == s)">@s</option>
                                }
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Notes</label>
                            <textarea name="Notes" class="form-control" rows="3">@Model.Notes</textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header"><h3 class="card-title">Live Summary</h3></div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Total Cost</span>
                        <span x-text="totalCost.toFixed(2)">0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Total Sale</span>
                        <span x-text="totalSale.toFixed(2)">0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-secondary">Tax</span>
                        <span x-text="totalTax.toFixed(2)">0.00</span>
                    </div>
                    <hr/>
                    <div class="d-flex justify-content-between fw-bold">
                        <span>Grand Total</span>
                        <span x-text="grandTotal.toFixed(2)">0.00</span>
                    </div>
                    <div class="mt-2">
                        <div class="d-flex justify-content-between text-secondary small mb-1">
                            <span>Margin</span>
                            <span x-text="margin.toFixed(1) + '%'">0.0%</span>
                        </div>
                        <div class="progress progress-sm">
                            <div class="progress-bar bg-green" :style="'width:' + Math.min(margin,100) + '%'"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header d-flex align-items-center">
            <h3 class="card-title mb-0">Itinerary Items</h3>
            <button type="button" class="btn btn-sm btn-outline-primary ms-auto" @@click="addItem()">
                <i class="ti ti-plus me-1"></i>Add Item
            </button>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th style="width:50px">Day</th>
                        <th style="width:110px">Date</th>
                        <th style="width:120px">Type</th>
                        <th>Description</th>
                        <th style="width:65px" class="text-end">Qty</th>
                        <th style="width:90px" class="text-end">Cost</th>
                        <th style="width:90px" class="text-end">Sale</th>
                        <th style="width:70px" class="text-end">Tax%</th>
                        <th style="width:90px" class="text-end">Total</th>
                        <th style="width:40px"></th>
                    </tr>
                </thead>
                <tbody>
                    <template x-for="(item, idx) in items" :key="idx">
                        <tr>
                            <td>
                                <input type="number" :name="'Items[' + idx + '].DayNo'" x-model="item.dayNo"
                                       class="form-control form-control-sm" min="1" placeholder="#"/>
                            </td>
                            <td>
                                <input type="date" :name="'Items[' + idx + '].ItemDate'" x-model="item.itemDate"
                                       class="form-control form-control-sm"/>
                            </td>
                            <td>
                                <select :name="'Items[' + idx + '].ItemType'" x-model="item.itemType"
                                        class="form-select form-select-sm">
                                    <template x-for="t in ['Hotel','Flight','Transport','Sightseeing','Meal','Misc']">
                                        <option :value="t" :selected="item.itemType === t" x-text="t"></option>
                                    </template>
                                </select>
                            </td>
                            <td>
                                <input type="text" :name="'Items[' + idx + '].Description'" x-model="item.description"
                                       class="form-control form-control-sm" placeholder="Description"/>
                            </td>
                            <td>
                                <input type="number" :name="'Items[' + idx + '].Qty'" x-model.number="item.qty"
                                       class="form-control form-control-sm text-end" step="0.01" min="0"/>
                            </td>
                            <td>
                                <input type="number" :name="'Items[' + idx + '].UnitCost'" x-model.number="item.unitCost"
                                       class="form-control form-control-sm text-end" step="0.01" min="0"/>
                            </td>
                            <td>
                                <input type="number" :name="'Items[' + idx + '].UnitSale'" x-model.number="item.unitSale"
                                       class="form-control form-control-sm text-end" step="0.01" min="0"/>
                            </td>
                            <td>
                                <input type="number" :name="'Items[' + idx + '].TaxRate'" x-model.number="item.taxRate"
                                       class="form-control form-control-sm text-end" step="0.01" min="0" max="100"/>
                            </td>
                            <td class="text-end fw-semibold" x-text="(item.qty * item.unitSale * (1 + item.taxRate / 100)).toFixed(2)">0.00</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-ghost-danger" @@click="removeItem(idx)">
                                    <i class="ti ti-trash"></i>
                                </button>
                            </td>
                        </tr>
                    </template>
                    <tr x-show="items.length === 0">
                        <td colspan="10" class="text-center text-secondary py-3">
                            No items yet. Click "Add Item" to start.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex">
        <a href="@pathBase/bookings" class="btn me-auto">Cancel</a>
        <button type="submit" class="btn btn-primary">
            <i class="ti ti-device-floppy me-1"></i>@(isEdit ? "Save Changes" : "Create Booking")
        </button>
    </div>
</form>

<script>
function bookingBuilder(initialItems) {
    return {
        items: initialItems.length ? initialItems : [],
        addItem() {
            this.items.push({ dayNo: '', itemDate: '', itemType: 'Misc', description: '', qty: 1, unitCost: 0, unitSale: 0, taxRate: 0 });
        },
        removeItem(idx) { this.items.splice(idx, 1); },
        get totalCost() { return this.items.reduce((s, i) => s + i.qty * i.unitCost, 0); },
        get totalSale() { return this.items.reduce((s, i) => s + i.qty * i.unitSale, 0); },
        get totalTax()  { return this.items.reduce((s, i) => s + i.qty * i.unitSale * i.taxRate / 100, 0); },
        get grandTotal() { return this.totalSale + this.totalTax; },
        get margin() { return this.grandTotal > 0 ? (this.grandTotal - this.totalCost) / this.grandTotal * 100 : 0; }
    };
}
</script>
